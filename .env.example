# FastAPI server configuration. Copy this file to the repository root as .env.
# Replace the Gemini placeholder with a NEW key; the previously shared key
# should be rotated before use.
GEMINI_API_KEY=replace-with-a-new-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_CHAT_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536

# Optional independent operator-provisioned project (server only). Keep blank
# unless BOTH project IDs are known and distinct. Never rotate same-project keys.
# Generation reuses the two configured models; embeddings reuse the EXACT same
# model and dimensions as the existing index. No automatic model substitution.
GEMINI_PROJECT_ID=
GEMINI_SECONDARY_PROJECT_ID=
GEMINI_SECONDARY_API_KEY=

# Supabase server settings. The secret key is server-only and bypasses RLS;
# reserve it for authorized administrative ingestion, never normal user queries.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# API
API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
