# FastAPI server configuration. For an existing setup, edit its root .env;
# do not overwrite Supabase settings. Never put Gemini keys in NEXT_PUBLIC_ vars.
GEMINI_API_KEY=replace-with-a-new-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
# Outer provider budget. Interactive generation also has a hard 12-second cap;
# embeddings retain their existing deadline and fixed model/dimension pair.
GENERATION_BUDGET_SECONDS=45

# Optional independent operator-provisioned project (server only). Keep blank
# unless BOTH project IDs are known and distinct. Never rotate same-project keys.
# Generation reuses the two configured models; embeddings reuse the EXACT same
# model and dimensions as the existing index. No automatic model substitution.
# Fill these three entries and GEMINI_API_KEY for cross-project fallback.
# Use actual Google Cloud project IDs, not display names or project numbers.
# One embedding attempt per project, bounded by GENERATION_BUDGET_SECONDS.
# Only transient/quota/availability failures fail over. Restart the API after edits.
GEMINI_PROJECT_ID=
GEMINI_SECONDARY_PROJECT_ID=
GEMINI_SECONDARY_API_KEY=

# Supabase server settings. The secret key is server-only and bypasses RLS;
# reserve it for authorized administrative ingestion, never normal user queries.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# API
API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

# Hosted ingestion uses private Supabase Storage and actual verified CEO users.
# Local behavior remains the default. Render's Docker image sets these values.
INGESTION_ENABLED=false
ORIGINAL_STORAGE=local
OCR_ENGINE=paddleocr
